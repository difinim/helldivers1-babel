<Window x:Class="Babel.App.Views.QuickChatOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Helldivers 1 Babel Quick Chat"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.18"/>
        </Storyboard>
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0" Duration="0:0:0.22"/>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="16">
        <Border x:Name="OverlayBorder"
                Background="#F214171E"
                BorderBrush="#60FFE600"
                BorderThickness="1"
                CornerRadius="8"
                MinWidth="340"
                MaxWidth="480"
                Padding="16,14">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="OverlayScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
            </Border.LayoutTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Badge -->
                    <Border Grid.Column="0"
                            Width="36" Height="36"
                            CornerRadius="18"
                            Background="#20FFE600"
                            BorderBrush="#FFE600"
                            BorderThickness="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Top">
                        <TextBlock Text="💬"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FFE600"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title & Badge -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Quick Chat Reference"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="#ECEFF4"
                                       TextTrimming="CharacterEllipsis"/>

                            <Border Grid.Column="1"
                                    Background="#20FFE600"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    Margin="8,0,0,0">
                                <TextBlock Text="QUICK CHAT"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#FFE600"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="Active Tactical Callouts"
                                   FontSize="11"
                                   Foreground="#A0A5B5"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="2"
                            Content="✕"
                            FontSize="10"
                            Foreground="#6B7280"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalAlignment="Top"
                            Margin="8,-4,-4,0"
                            Click="OnCloseClicked">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Padding="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#ECEFF4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Divider -->
                <Rectangle Grid.Row="1" Height="1" Fill="#2A303C" Margin="0,10,0,8"/>

                <!-- Quick Chat Items List -->
                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="EmptyNotice"
                               Text="No active Quick Chat callouts configured."
                               FontSize="12"
                               Foreground="#8B949E"
                               FontStyle="Italic"
                               Margin="0,4"
                               Visibility="Collapsed"/>

                    <ItemsControl x:Name="MacroItemsControl" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="12"
                                           FontFamily="Segoe UI, Consolas"
                                           Foreground="#ECEFF4"
                                           Margin="0,3"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Footer Hint -->
                <TextBlock Grid.Row="3"
                           x:Name="FooterHint"
                           Text="Press shortcut to hide"
                           FontSize="10"
                           Foreground="#555C6D"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
