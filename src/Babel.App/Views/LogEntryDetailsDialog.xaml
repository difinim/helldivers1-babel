<Window x:Class="Babel.App.Views.LogEntryDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Trans_MsgDetails_Title}"
        FlowDirection="{DynamicResource App_FlowDirection}"
        Icon="../Assets/hb.ico"
        Height="540" Width="640"
        MinHeight="460" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="#15171E"
        Foreground="#ECEFF4"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#222630"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3B4252"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="contentPresenter"
                                              Focusable="False"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#383E4C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFE600"/>
                                <Setter Property="Foreground" Value="#FFE600"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#282D37"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFE600"/>
                                <Setter Property="Foreground" Value="#FFE600"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#171920"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#262B36"/>
                                <Setter Property="Foreground" Value="#555C6D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#101216"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="BorderBrush" Value="#262B36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CaretBrush" Value="#FFE600"/>
            <Setter Property="SelectionBrush" Value="#FFE600"/>
            <Setter Property="SelectionOpacity" Value="0.4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2D323F" BorderThickness="1" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Metadata Card -->
                <RowDefinition Height="*"/>    <!-- Original Message -->
                <RowDefinition Height="*"/>    <!-- Translated Message -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="../Assets/hb.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Trans_MsgDetails_Header}" FontWeight="Bold" FontSize="15" Foreground="#FFE600"/>
                </StackPanel>
            </Grid>

            <!-- Metadata Card -->
            <Border Grid.Row="1" Background="#1A1D24" BorderBrush="#262B36" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Player Column -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                        <Ellipse x:Name="PlayerColorIndicator" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#FFD700"/>
                        <TextBlock Text="{DynamicResource Col_Player}" Foreground="#8B949E" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PlayerNameText" FontWeight="Bold" FontSize="13" Foreground="#ECEFF4" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Detected Language Column -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Margin="16,0,0,0">
                        <TextBlock Text="{DynamicResource Col_Detected}" Foreground="#8B949E" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <Border Background="#252A36" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="DetectedLangText" FontWeight="SemiBold" FontSize="11" Foreground="#FFE600" FlowDirection="LeftToRight"/>
                        </Border>
                    </StackPanel>

                    <!-- Date & Time Column -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Margin="16,0,0,0" FlowDirection="LeftToRight">
                        <TextBlock x:Name="DateText" FontSize="12" Foreground="#D8DEE9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TimeText" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Latency Column -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" Margin="16,0,0,0" FlowDirection="LeftToRight">
                        <TextBlock x:Name="LatencyText" FontSize="11" Foreground="#6C7280" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Original Message Section -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource Col_OriginalMessage}" FontWeight="SemiBold" FontSize="12" Foreground="#A0A5B5" VerticalAlignment="Center"/>
                    <Button Content="{DynamicResource Trans_MsgDetails_CopyOriginal}" HorizontalAlignment="Right" Padding="8,3" FontSize="11" Click="OnCopyOriginalClicked"/>
                </Grid>
                <TextBox x:Name="OriginalMessageTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
            </Grid>

            <!-- Translated Message Section -->
            <Grid Grid.Row="3" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource Col_TranslatedMessage}" FontWeight="SemiBold" FontSize="12" Foreground="#FFE600" VerticalAlignment="Center"/>
                    <Button Content="{DynamicResource Trans_MsgDetails_CopyTranslated}" HorizontalAlignment="Right" Padding="8,3" FontSize="11" Click="OnCopyTranslatedClicked"/>
                </Grid>
                <TextBox x:Name="TranslatedMessageTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
            </Grid>

            <!-- Footer Actions -->
            <Grid Grid.Row="4">
                <Button Content="{DynamicResource Trans_MsgDetails_CopyFormatted}" HorizontalAlignment="Left" Padding="12,6" Click="OnCopyFormattedClicked"/>
                <Button Content="{DynamicResource About_Btn_Close}" HorizontalAlignment="Right" Padding="16,6" IsCancel="True" Click="OnCloseClicked"/>
            </Grid>
        </Grid>
    </Border>
</Window>
