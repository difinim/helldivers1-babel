<Window x:Class="Babel.App.Views.ToastOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Helldivers 1 Babel Toast"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.18"/>
        </Storyboard>
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0" Duration="0:0:0.25"/>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="16" Cursor="Hand" MouseLeftButtonUp="OnToastClicked">
        <Border x:Name="ToastBorder"
                Background="#F214171E"
                BorderBrush="#2A303C"
                BorderThickness="1"
                CornerRadius="8"
                MinWidth="320"
                MaxWidth="420"
                Padding="14,12">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="ToastScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
            </Border.LayoutTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Badge Container -->
                <Border x:Name="IconBadge"
                        Grid.Column="0"
                        Width="36" Height="36"
                        CornerRadius="18"
                        Background="#2064FF78"
                        BorderBrush="#64FF78"
                        BorderThickness="1"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconText"
                               Text="▶"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#64FF78"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Content Area -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TitleText"
                                   Grid.Column="0"
                                   Text="Helldivers 1 Babel"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="#ECEFF4"
                                   TextTrimming="CharacterEllipsis"/>

                        <Border x:Name="BadgeBorder"
                                Grid.Column="1"
                                Background="#2064FF78"
                                CornerRadius="4"
                                Padding="6,1"
                                Margin="8,0,0,0">
                            <TextBlock x:Name="BadgeText"
                                       Text="ACTIVE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#64FF78"/>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="MessageText"
                               Text="Assistant Active"
                               FontSize="12"
                               Foreground="#A0A5B5"
                               TextWrapping="Wrap"
                               MaxHeight="60"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2"
                        Content="✕"
                        FontSize="10"
                        Foreground="#6B7280"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Top"
                        Margin="8,-4,-4,0"
                        Click="OnCloseClicked">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" Padding="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#ECEFF4"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
