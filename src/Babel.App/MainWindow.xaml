<Window x:Class="Babel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Babel.App"
        xmlns:controls="clr-namespace:Babel.App.Controls"
        xmlns:vm="clr-namespace:Babel.App.ViewModels"
        mc:Ignorable="d"
        Title="Helldivers 1 Babel — Tactical Translation Assistant"
        Icon="Assets/hb.ico"
        Height="851" Width="1128"
        MinHeight="550" MinWidth="800"
        Background="#111317"
        Foreground="#ECEFF4"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- TabItem Style with Medium Gray Selected State -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#A0A5B5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#1C1F26"
                                BorderBrush="#2D323F"
                                BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#252A36"/>
                                <Setter Property="Foreground" Value="#E0E6F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#323846"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#FFE600"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,2,1,0"/>
                                <Setter Property="Foreground" Value="#FFE600"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Background" Value="#15171D"/>
                                <Setter Property="Foreground" Value="#555C6D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#222630"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3B4252"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="contentPresenter"
                                              Focusable="False"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#383E4C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFE600"/>
                                <Setter Property="Foreground" Value="#FFE600"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#282D37"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFE600"/>
                                <Setter Property="Foreground" Value="#FFE600"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#171920"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#262B36"/>
                                <Setter Property="Foreground" Value="#555C6D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#191B22"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2D323F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#FFE600"/>
        </Style>

        <!-- ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border"
                        Grid.ColumnSpan="2"
                        CornerRadius="4"
                        Background="#2B303C"
                        BorderBrush="#3E4554"
                        BorderThickness="1"
                        SnapsToDevicePixels="True"/>
                <Border Grid.Column="1" Margin="0,4,4,4" Background="Transparent">
                    <Path x:Name="Arrow"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="#A0A5B5"
                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#343A48"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#FFE600"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFE600"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#343A48"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#FFE600"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFE600"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="Background" Value="#181B22"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#262B36"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#555C6D"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3C4352"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#495264"/>
                                <Setter Property="Foreground" Value="#FFE600"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#555C6D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style with Medium Gray Background -->
        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- ToggleButton covering entire ComboBox -->
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            
                            <!-- ContentPresenter for selected item -->
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,4,30,4"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            
                            <!-- Dropdown Popup -->
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#252934"
                                            BorderBrush="#3E4554"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,2,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.4" Direction="270" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="30"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#555C6D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8DEE9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Dark ToolTip Style with Helldivers Yellow accent -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1B1E26"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="BorderBrush" Value="#FFE600"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>

        <!-- Setting Label Style -->
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE600"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Info (i) Tooltip Icon Style -->
        <Style x:Key="InfoIconStyle" TargetType="Border">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#222631"/>
            <Setter Property="BorderBrush" Value="#383E4C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFE600"/>
                    <Setter Property="Background" Value="#33FFE600"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InfoGlyphStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="i"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#FFE600"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,-1,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Status Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Tabs -->
            <RowDefinition Height="*"/>
            <!-- Bottom Footer / Status -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Top Bar -->
        <Border Grid.Row="0" Background="#181B22" BorderBrush="#262B36" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/hb.png" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="HELLDIVERS 1 BABEL" FontWeight="Bold" FontSize="16" Foreground="#FFE600" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion}" FontSize="11" Foreground="#6C7280" Margin="8,4,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Game Status -->
                    <Border CornerRadius="4" Background="#111317" Padding="10,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding IsGameRunning, Converter={x:Null}}" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#E06C75"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                                <Setter Property="Fill" Value="#00E676"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding GameStatusText}" FontSize="12" Foreground="#D8DEE9"/>
                        </StackPanel>
                    </Border>

                    <!-- Pipe Status -->
                    <Border CornerRadius="4" Background="#111317" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#E06C75"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPipeConnected}" Value="True">
                                                <Setter Property="Fill" Value="#00E676"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="12" Foreground="#D8DEE9">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Pipe: Disconnected"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPipeConnected}" Value="True">
                                                <Setter Property="Text" Value="Pipe: Connected"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Pause/Resume State & Action -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#003314"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Background" Value="#332B00"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusBadgeText}" FontWeight="Bold" FontSize="12" Foreground="{Binding StatusBadgeColor}"/>
                    </Border>
                    <Button Content="{Binding PauseResumeButtonText}" Click="OnTogglePauseClicked" Padding="10,4" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Background="#111317" BorderBrush="#262B36" BorderThickness="0" Margin="16,12,16,8">
            <!-- TAB 1: TRANSLATION & LOGS -->
            <TabItem Header="Translation &amp; Logs">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Quick Controls Bar -->
                    <Border Grid.Row="0" Background="#181B22" BorderBrush="#262B36" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Target Language:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding TargetLanguage}" Margin="0,0,16,0"/>

                            <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                <CheckBox Content="Incoming Translation" IsChecked="{Binding IncomingEnabled}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <CheckBox Content="Outgoing Translation (&gt;&gt;)" IsChecked="{Binding OutgoingEnabled}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <CheckBox Content="Don't translate standard outgoing" IsChecked="{Binding DontTranslateStandardOutgoing}" ToolTip="When checked (default), your own messages that do not contain '&gt;&gt;' are not translated." Margin="0,0,16,0" VerticalAlignment="Center"/>
                            </WrapPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Export Logs" Click="OnExportLogsClicked" Margin="0,0,8,0"/>
                                <Button Content="Clear Logs" Click="OnClearLogsClicked"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Translation History Grid -->
                    <DataGrid x:Name="HistoryDataGrid" Grid.Row="1" ItemsSource="{Binding History}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserResizeColumns="True"
                              Background="#15171D" BorderBrush="#262B36" BorderThickness="1"
                              RowBackground="#181B22" AlternatingRowBackground="#1D2028"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#262B36"
                              Foreground="#ECEFF4">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#ECEFF4"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="#ECEFF4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2D3340"/>
                                        <Setter Property="Foreground" Value="#FFE600"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1A1D24"/>
                                <Setter Property="Foreground" Value="#FFE600"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="#262B36"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                            <Style x:Key="LogTextColStyle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#ECEFF4"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="75" ElementStyle="{StaticResource LogTextColStyle}"/>
                            <DataGridTemplateColumn Header="Player" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Author}" FontWeight="Bold" Foreground="{Binding ColorHex}" VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Detected" Binding="{Binding SourceLang}" Width="90" ElementStyle="{StaticResource LogTextColStyle}"/>
                            <DataGridTemplateColumn Header="Original Message" Width="*" SortMemberPath="OriginalMessage">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock controls:LinkAwareTextBlock.FormattedText="{Binding OriginalMessage}"
                                                   Style="{StaticResource LogTextColStyle}"
                                                   Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Translated Message" Binding="{Binding TranslatedMessage}" Width="*" ElementStyle="{StaticResource LogTextColStyle}"/>
                            <DataGridTextColumn Header="Latency" Binding="{Binding Latency}" Width="70" ElementStyle="{StaticResource LogTextColStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: QUICK CHAT -->
            <TabItem Header="Quick Chat">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Bind pre-defined tactical callouts to hotkeys. These will be immediately broadcast to teammates in in-game chat."
                               Foreground="#A0A5B5" FontSize="12" Margin="0,0,0,10"/>

                    <!-- Quick Chat List -->
                    <Border Grid.Row="1" Background="#181B22" BorderBrush="#262B36" BorderThickness="1" CornerRadius="4" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Macros}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#262B36" Padding="4,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowBottomBorder}" Value="False">
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>

                                                <controls:ShortcutRecorder Grid.Column="0" Hotkey="{Binding Keybinding, Mode=TwoWay}" Margin="0,0,10,0"/>
                                                
                                                <TextBox Grid.Column="1" Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" ToolTip="In-game chat message"/>

                                                <CheckBox Grid.Column="2" Content="Active" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"/>

                                                <Button Grid.Column="3" Content="Test Send" Tag="{Binding SlotId}" Click="OnTestSendMacroClicked"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="Import Messages" Click="OnImportQuickChatClicked" Margin="0,0,8,0" Padding="14,8" ToolTip="Import Quick Chat messages from a JSON file (shortcuts and active states remain unchanged)"/>
                            <Button Content="Export Messages" Click="OnExportQuickChatClicked" Padding="14,8" ToolTip="Export Quick Chat messages to a JSON file"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Save Quick Chat" Click="OnSaveMacrosClicked" Padding="16,8"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 3: SETTINGS & PROVIDERS -->
            <!-- TAB 3: SETTINGS -->
            <TabItem Header="Settings">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <!-- Group 1: General -->
                        <Border Background="#181B22" BorderBrush="#262B36" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="General" FontSize="14" FontWeight="Bold" Foreground="#FFE600" Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Saved Messages Limit -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="Saved Messages Limit:" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource InfoIconStyle}" ToolTip="Limits persistent table chat logs on disk from 0 to 100 MB. Setting to 0 MB disables persistent chat logging to disk.">
                                            <TextBlock Style="{StaticResource InfoGlyphStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,6" VerticalAlignment="Center">
                                        <Slider Width="180" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ChatHistoryLimitMb, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ChatHistoryLimitDisplay}" Width="85" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFE600"/>
                                        <Button Content="Clear logs memory" Click="OnClearLogsMemoryClicked" Margin="16,0,0,0" Padding="10,4"/>
                                    </StackPanel>

                                    <!-- Request Timeout -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="Request Timeout:" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource InfoIconStyle}" ToolTip="Maximum wait time for AI provider translation responses before timing out (1 to 15 seconds).">
                                            <TextBlock Style="{StaticResource InfoGlyphStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                        <Slider Width="200" Minimum="1" Maximum="15" Value="{Binding TimeoutSeconds}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TimeoutSeconds, StringFormat='{}{0:F1}s'}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFE600"/>
                                    </StackPanel>

                                    <!-- Diagnostic Logs -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="Diagnostic Logs:" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource InfoIconStyle}" ToolTip="Enable file logging to app.log, hook.log, and injector.log in AppData for troubleshooting.">
                                            <TextBlock Style="{StaticResource InfoGlyphStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6" VerticalAlignment="Center">
                                        <CheckBox Content="Enable File Logging (app.log, hook.log, injector.log)" IsChecked="{Binding DebugLoggingEnabled}" VerticalAlignment="Center" Foreground="#E0E0E0"/>
                                        <Button Content="Open Logs Folder" Click="OnOpenLogsClicked" Margin="16,0,0,0" Padding="10,4"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Group 2: Global Shortcuts -->
                        <Border Background="#181B22" BorderBrush="#262B36" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Global Shortcuts" FontSize="14" FontWeight="Bold" Foreground="#FFE600" Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Global Pause/Resume Shortcut -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="Pause/Resume Shortcut:" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource InfoIconStyle}" ToolTip="Master shortcut to pause or resume both Translation and Quick Chat simultaneously.">
                                            <TextBlock Style="{StaticResource InfoGlyphStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                        <controls:ShortcutRecorder Hotkey="{Binding PauseHotkey, Mode=TwoWay}" Width="160"/>
                                    </StackPanel>

                                    <!-- Toggle Translation Shortcut -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="Toggle Translation Shortcut:" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource InfoIconStyle}" ToolTip="Shortcut to toggle only chat translation on or off without affecting Quick Chat.">
                                            <TextBlock Style="{StaticResource InfoGlyphStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                        <controls:ShortcutRecorder Hotkey="{Binding ToggleTranslationHotkey, Mode=TwoWay}" Width="160"/>
                                    </StackPanel>

                                    <!-- Toggle Quick Chat Shortcut -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="Toggle Quick Chat Shortcut:" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource InfoIconStyle}" ToolTip="Shortcut to toggle only tactical Quick Chat messages on or off without affecting Translation.">
                                            <TextBlock Style="{StaticResource InfoGlyphStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                        <controls:ShortcutRecorder Hotkey="{Binding ToggleQuickChatHotkey, Mode=TwoWay}" Width="160"/>
                                    </StackPanel>

                                    <!-- Quick Chat Overlay Shortcut -->
                                    <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="Quick Chat Overlay Shortcut:" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource InfoIconStyle}" ToolTip="Shortcut to toggle the on-screen tactical callouts overlay. Note: Helldivers must be running in Borderless Fullscreen (or Windowed) mode for the overlay to appear over the game.">
                                            <TextBlock Style="{StaticResource InfoGlyphStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6" VerticalAlignment="Center">
                                        <controls:ShortcutRecorder Hotkey="{Binding QuickChatOverlayHotkey, Mode=TwoWay}" Width="160"/>
                                        <Button Content="Test Overlay" Click="OnTestQuickChatOverlayClicked" Margin="12,0,0,0" Padding="10,4"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Group 3: Display -->
                        <Border Background="#181B22" BorderBrush="#262B36" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Display" FontSize="14" FontWeight="Bold" Foreground="#FFE600" Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- On-Screen Toast Notifications -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="Toast Notifications:" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource InfoIconStyle}" ToolTip="Show on-screen popups for Pause/Resume, errors, and system tray events without losing game focus.">
                                            <TextBlock Style="{StaticResource InfoGlyphStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,6" VerticalAlignment="Center">
                                        <CheckBox Content="Enable On-Screen Toast Overlay" IsChecked="{Binding ShowToastOverlay, Mode=TwoWay}" VerticalAlignment="Center" Foreground="#E0E0E0" FontWeight="SemiBold"/>
                                        <Button Content="Test Notification" Click="OnTestToastClicked" Margin="16,0,0,0" Padding="10,4" ToolTip="Preview on-screen toast notification"/>
                                    </StackPanel>

                                    <!-- Toast Position -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="Toast Position:" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource InfoIconStyle}" ToolTip="Click button to open the 9-point screen anchor modal and choose where toast popups appear.">
                                            <TextBlock Style="{StaticResource InfoGlyphStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6" VerticalAlignment="Center">
                                        <Button Content="{Binding ToastPositionDisplay}" Click="OnSelectToastPositionClicked" Padding="14,4" MinWidth="130" ToolTip="Configure anchor position on screen for toasts"/>
                                    </StackPanel>

                                    <!-- Quick Chat Overlay Position -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="Quick Chat Position:" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource InfoIconStyle}" ToolTip="Click button to open the 9-point screen anchor modal and choose where the tactical Quick Chat overlay appears.">
                                            <TextBlock Style="{StaticResource InfoGlyphStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6" VerticalAlignment="Center">
                                        <Button Content="{Binding QuickChatOverlayPositionDisplay}" Click="OnSelectQuickChatPositionClicked" Padding="14,4" MinWidth="130" ToolTip="Configure anchor position on screen for Quick Chat overlay"/>
                                    </StackPanel>

                                    <!-- Overlay & Toast Size -->
                                    <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="Overlay &amp; Toast Size:" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource InfoIconStyle}" ToolTip="Visual scale percentage for on-screen toasts and Quick Chat overlay (50% to 200%). Sliding shows a 2-second idle preview.">
                                            <TextBlock Style="{StaticResource InfoGlyphStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6" VerticalAlignment="Center">
                                        <Slider Width="180" Minimum="50" Maximum="200" TickFrequency="25" SmallChange="25" LargeChange="25" IsSnapToTickEnabled="True" 
                                                Value="{Binding OverlayScalePercent, Mode=TwoWay}" 
                                                PreviewMouseLeftButtonDown="OnOverlaySliderMouseDown"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding OverlayScaleDisplay}" Width="120" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFE600"/>
                                    </StackPanel>

                                    <!-- Target Display -->
                                    <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="Target Display:" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource InfoIconStyle}" ToolTip="Select which monitor overlays appear on. 'Auto' dynamically follows the Helldivers game window.">
                                            <TextBlock Style="{StaticResource InfoGlyphStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,6" VerticalAlignment="Center">
                                        <ComboBox ItemsSource="{Binding AvailableDisplays}" SelectedItem="{Binding TargetDisplay, Mode=TwoWay}" Width="260" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Group 4: AI Translation Provider -->
                        <Border Background="#181B22" BorderBrush="#262B36" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="AI Translation Provider" FontSize="14" FontWeight="Bold" Foreground="#FFE600" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Provider Selection Dropdown -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="Translation Provider:" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource InfoIconStyle}" ToolTip="Select the active AI translation engine. Currently Google Gemini is supported; other providers coming soon.">
                                            <TextBlock Style="{StaticResource InfoGlyphStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox Grid.Row="0" Grid.Column="1" Width="260" HorizontalAlignment="Left" Margin="0,6" SelectedIndex="0">
                                        <ComboBoxItem Content="Google Gemini (Active)" IsSelected="True"/>
                                        <ComboBoxItem Content="OpenAI ChatGPT (Coming Soon)" IsEnabled="False"/>
                                        <ComboBoxItem Content="Anthropic Claude (Coming Soon)" IsEnabled="False"/>
                                        <ComboBoxItem Content="DeepSeek (Coming Soon)" IsEnabled="False"/>
                                        <ComboBoxItem Content="Self-host (Coming Soon)" IsEnabled="False"/>
                                    </ComboBox>

                                    <!-- Gemini API Key -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="Google Gemini API Key:" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource InfoIconStyle}" ToolTip="Your Google Gemini API key. Stored encrypted on disk and never logged.">
                                            <TextBlock Style="{StaticResource InfoGlyphStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="GeminiPasswordBox" PasswordChanged="OnGeminiPasswordChanged" Background="#191B22" Foreground="#FFFFFF" BorderBrush="#2D323F" Padding="6,4"/>
                                        <TextBox x:Name="GeminiPlainTextBox" Visibility="Collapsed" Text="{Binding GeminiApiKey, UpdateSourceTrigger=PropertyChanged}" Background="#191B22" Foreground="#FFFFFF" BorderBrush="#2D323F" Padding="6,4"/>
                                        <Button Grid.Column="1" x:Name="BtnShowHideKey" Content="Show" Click="OnToggleShowApiKeyClicked" Margin="6,0,0,0" Padding="8,4"/>
                                    </Grid>

                                    <!-- Gemini Model -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="Gemini Model:" Style="{StaticResource SettingLabelStyle}"/>
                                        <Border Style="{StaticResource InfoIconStyle}" ToolTip="Gemini model identifier to use for translations (e.g. gemini-flash-lite-latest).">
                                            <TextBlock Style="{StaticResource InfoGlyphStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GeminiModel, UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>
                                </Grid>

                                <!-- Test API Button & Feedback (Right Side) -->
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TestApiStatus}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#FFE600" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" Content="Test API Connection" Click="OnTestApiClicked" Padding="14,6"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Footer Action Buttons: Reset All Settings (Left) and Save All Settings (Right) -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Reset All Settings" Click="OnResetAllSettingsClicked"
                                    Background="#221C20" BorderBrush="#4A2A2E" Foreground="#FF9999"
                                    Padding="14,8" ToolTip="Reset all settings across Translation &amp; Logs and Settings tabs back to their default values"/>

                            <Button Grid.Column="2" Content="Save All Settings" Click="OnSaveSettingsClicked"
                                    Padding="16,8"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer Bar -->
        <Border Grid.Row="2" Background="#0C0E11" BorderBrush="#1C2028" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Helldivers (2015) | Tactical Translation &amp; Quick Chat Assistant" FontSize="11" Foreground="#555C6D" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Hyperlink Click="OnOpenLogsClicked" Foreground="#8B949E" TextDecorations="None" Cursor="Hand">
                            <Hyperlink.Style>
                                <Style TargetType="Hyperlink">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#FFE600"/>
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Hyperlink.Style>
                            Logs
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock FontSize="11" VerticalAlignment="Center">
                        <Hyperlink Click="OnGitHubLinkClicked" Foreground="#58A6FF" TextDecorations="Underline" Cursor="Hand">
                            <Hyperlink.Style>
                                <Style TargetType="Hyperlink">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#79C0FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Hyperlink.Style>
                            github.com/difinim/helldivers1-babel
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
